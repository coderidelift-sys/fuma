// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  email       String   @unique @db.VarChar(100)
  whatsapp    String?  @db.VarChar(20)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  role        Role     @default(VIEWER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Team {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  shortName       String   @map("short_name") @db.VarChar(10)
  logoUrl         String?  @map("logo_url") @db.VarChar(255)
  foundedYear     Int?     @map("founded_year")
  stadium         String?  @db.VarChar(100)
  stadiumCapacity Int?     @map("stadium_capacity")
  city            String?  @db.VarChar(100)
  country         String?  @db.VarChar(100)
  managerName     String?  @map("manager_name") @db.VarChar(100)
  teamColors      String?  @map("team_colors") @db.VarChar(100)
  status          TeamStatus @default(ACTIVE)
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  players         Player[]
  homeMatches     Match[] @relation("HomeTeam")
  awayMatches     Match[] @relation("AwayTeam")
  tournamentTeams TournamentTeam[]
  matchEvents     MatchEvent[]

  @@map("teams")
}

model Player {
  id           Int      @id @default(autoincrement())
  teamId       Int?     @map("team_id")
  firstName    String   @map("first_name") @db.VarChar(50)
  lastName     String   @map("last_name") @db.VarChar(50)
  jerseyNumber Int?     @map("jersey_number")
  position     Position
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  nationality  String?  @db.VarChar(50)
  height       Decimal? @db.Decimal(3, 2)
  weight       Decimal? @db.Decimal(5, 2)
  preferredFoot PreferredFoot? @map("preferred_foot")
  photoUrl     String?  @map("photo_url") @db.VarChar(255)
  marketValue  Decimal? @map("market_value") @db.Decimal(12, 2)
  status       PlayerStatus @default(ACTIVE)

  // Relations
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  matchEvents  MatchEvent[]
  statistics   PlayerStatistic[]

  @@unique([teamId, jerseyNumber], name: "unique_team_jersey")
  @@map("players")
}

model Tournament {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  tournamentType TournamentType @map("tournament_type")
  status         TournamentStatus @default(UPCOMING)
  maxTeams       Int?     @map("max_teams")
  prizeMoney     Decimal? @map("prize_money") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  matches        Match[]
  tournamentTeams TournamentTeam[]
  statistics     PlayerStatistic[]

  @@map("tournaments")
}

model TournamentTeam {
  id           Int @id @default(autoincrement())
  tournamentId Int @map("tournament_id")
  teamId       Int @map("team_id")
  groupName    String? @map("group_name") @db.VarChar(10)
  points       Int @default(0)
  matchesPlayed Int @default(0) @map("matches_played")
  wins         Int @default(0)
  draws        Int @default(0)
  losses       Int @default(0)
  goalsFor     Int @default(0) @map("goals_for")
  goalsAgainst Int @default(0) @map("goals_against")

  // Relations
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId], name: "unique_tournament_team")
  @@map("tournament_teams")
}

model Match {
  id               Int      @id @default(autoincrement())
  tournamentId     Int      @map("tournament_id")
  homeTeamId       Int      @map("home_team_id")
  awayTeamId       Int      @map("away_team_id")
  matchDate        DateTime @map("match_date")
  venue            String?  @db.VarChar(100)
  referee          String?  @db.VarChar(100)
  status           MatchStatus @default(SCHEDULED)
  homeScore        Int      @default(0) @map("home_score")
  awayScore        Int      @default(0) @map("away_score")
  matchStage       String?  @map("match_stage") @db.VarChar(50)
  attendance       Int?
  weatherConditions String? @map("weather_conditions") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  tournament       Tournament @relation(fields: [tournamentId], references: [id])
  homeTeam         Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam         Team @relation("AwayTeam", fields: [awayTeamId], references: [id])
  events           MatchEvent[]
  liveData         LiveMatchData?

  @@map("matches")
}

model MatchEvent {
  id             Int @id @default(autoincrement())
  matchId        Int @map("match_id")
  playerId       Int? @map("player_id")
  teamId         Int @map("team_id")
  eventType      EventType @map("event_type")
  minute         Int
  additionalTime Int @default(0) @map("additional_time")
  description    String? @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  match          Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player         Player? @relation(fields: [playerId], references: [id])
  team           Team @relation(fields: [teamId], references: [id])

  @@map("match_events")
}

model PlayerStatistic {
  id             Int @id @default(autoincrement())
  playerId       Int @map("player_id")
  tournamentId   Int @map("tournament_id")
  matchesPlayed  Int @default(0) @map("matches_played")
  goals          Int @default(0)
  assists        Int @default(0)
  yellowCards    Int @default(0) @map("yellow_cards")
  redCards       Int @default(0) @map("red_cards")
  minutesPlayed  Int @default(0) @map("minutes_played")
  shotsOnTarget  Int @default(0) @map("shots_on_target")
  passesCompleted Int @default(0) @map("passes_completed")
  tacklesWon     Int @default(0) @map("tackles_won")

  // Relations
  player         Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentId], name: "unique_player_tournament")
  @@map("player_statistics")
}

model LiveMatchData {
  id             Int @id @default(autoincrement())
  matchId        Int @unique @map("match_id")
  currentMinute  Int @map("current_minute")
  additionalTime Int @default(0) @map("additional_time")
  possessionHome Int @default(50) @map("possession_home")
  possessionAway Int @default(50) @map("possession_away")
  shotsHome      Int @default(0) @map("shots_home")
  shotsAway      Int @default(0) @map("shots_away")
  cornersHome    Int @default(0) @map("corners_home")
  cornersAway    Int @default(0) @map("corners_away")
  foulsHome      Int @default(0) @map("fouls_home")
  foulsAway      Int @default(0) @map("fouls_away")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  match          Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("live_match_data")
}

// Enums
enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum PlayerStatus {
  ACTIVE
  INJURED
  SUSPENDED
  TRANSFERRED
}

enum TournamentType {
  LEAGUE
  KNOCKOUT
  GROUP_KNOCKOUT
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  COMPLETED
  POSTPONED
  CANCELLED
}

enum EventType {
  GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION_IN
  SUBSTITUTION_OUT
}